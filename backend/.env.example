# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Option 1: Use a full connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/client_management?schema=public"

# Option 2: Use individual variables (Railway will auto-link these from Postgres service)
# These are automatically populated when using Railway with ${{Postgres.PGHOST}}, etc.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=client_management
DB_USER=postgres
DB_PASSWORD=password

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# TRACCAR SMS GATEWAY CONFIGURATION
# These are required for SMS functionality
# ===========================================
# The URL of your Traccar SMS Gateway (from Cloudflare tunnel or direct)
TRACCAR_SMS_URL=http://localhost:5055
# The device ID registered in Traccar for SMS sending
TRACCAR_SMS_DEVICE_ID=your_device_id
# API token for Traccar authentication (if required)
TRACCAR_API_TOKEN=your_api_token_here

# ===========================================
# CLOUDFLARE TUNNEL CONFIGURATION
# Use this when accessing Traccar via Cloudflare tunnel
# ===========================================
# The public URL generated by Cloudflare tunnel on your PC
CLOUDFLARE_TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
# Maximum SMS messages per minute
SMS_RATE_LIMIT_PER_MINUTE=30
# Maximum SMS messages per hour
SMS_RATE_LIMIT_PER_HOUR=500
# Maximum retry attempts for failed messages
SMS_MAX_RETRIES=5
# Delay between retries in milliseconds (base delay, uses exponential backoff)
SMS_RETRY_DELAY_MS=60000
# API rate limit - requests per window
API_RATE_LIMIT_MAX=100
# API rate limit window in minutes
API_RATE_LIMIT_WINDOW_MINUTES=15

# ===========================================
# SMS BEST PRACTICES CONFIGURATION
# These settings help avoid getting banned by SMS providers
# ===========================================
# Maximum SMS messages per recipient per day
SMS_MAX_PER_RECIPIENT_PER_DAY=3
# Maximum SMS messages per recipient per week
SMS_MAX_PER_RECIPIENT_PER_WEEK=10
# Cooldown period between messages to same recipient (in hours)
SMS_RECIPIENT_COOLDOWN_HOURS=4
# Minimum hour to send SMS (24h format, e.g., 9 for 9:00 AM)
SMS_ALLOWED_START_HOUR=9
# Maximum hour to send SMS (24h format, e.g., 20 for 8:00 PM)
SMS_ALLOWED_END_HOUR=20
# Timezone for time-based restrictions (e.g., Europe/Bucharest)
SMS_TIMEZONE=Europe/Bucharest
# Maximum SMS length (standard SMS is 160 chars, concatenated up to 1600)
SMS_MAX_LENGTH=480
# Enable duplicate message prevention (true/false)
SMS_PREVENT_DUPLICATES=true
# Time window for duplicate detection (in hours)
SMS_DUPLICATE_WINDOW_HOURS=24
# Your company/sender name to include in messages for identification
SMS_SENDER_NAME=YourCompany
# Opt-out keyword that recipients can reply with
SMS_OPT_OUT_KEYWORD=STOP
# Whether to require opt-out info in messages (true/false)
SMS_REQUIRE_OPT_OUT_INFO=true
# Default country code for phone number normalization (e.g., +40 for Romania, +1 for US)
SMS_DEFAULT_COUNTRY_CODE=+40

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origin for CORS (frontend URL)
# Supports multiple origins separated by commas:
# CORS_ORIGIN=https://frontend1.railway.app,https://frontend2.railway.app
CORS_ORIGIN=http://localhost:3000

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ===========================================
# EXCEL IMPORT CONFIGURATION
# ===========================================
# Directory containing Excel files to import
EXCEL_DATA_DIRECTORY=./data

# ===========================================
# MESSAGE QUEUE CONFIGURATION
# ===========================================
# Interval in milliseconds for queue processor to check for new messages
QUEUE_PROCESS_INTERVAL_MS=5000
# Number of messages to process per batch
QUEUE_BATCH_SIZE=10
